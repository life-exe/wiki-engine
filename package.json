{
  "name": "@life-exe/wiki-engine",
  "version": "0.1.67",
  "type": "module",
  "description": "Modern, multilingual documentation and wiki engine built with React, Vite, and Tailwind CSS",
  "author": "Yuri Popov <life-exe>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "keywords": [
    "wiki",
    "documentation",
    "docs",
    "markdown",
    "react",
    "vite",
    "multilingual",
    "search",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/life-exe/wiki-engine.git"
  },
  "bin": {
    "wiki-check-links": "./bin/check-links.mjs",
    "check-wiki-links": "./bin/check-links.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./languages/ue-cpp": {
      "types": "./dist/languages/ue-cpp.d.ts",
      "import": "./dist/languages/ue-cpp.js"
    },
    "./check-links": {
      "types": "./bin/check-links.d.ts",
      "import": "./bin/check-links.mjs"
    },
    "./style.css": "./dist/wiki-engine.css",
    "./wiki-engine.css": "./dist/wiki-engine.css"
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "templates"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:links": "node ./bin/check-links.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
